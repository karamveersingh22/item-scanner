# Item Scanner One-Company Serverless Backend Configuration
# Copy this file to .env or .env.production and populate with your credentials.
# NEVER commit .env with real credentials into source control.

# Single-Company Configuration (Optional overrides; defaults provided in code)
COMPANY_NAME="Item Master Company"
ADMIN_USERNAME="admin"
# Bcrypt hash of admin password. If not provided, a secure default is initialized.
# Generate via: node -e "console.log(require('bcryptjs').hashSync('YourPassword123!', 12))"
ADMIN_PASSWORD_HASH=""

# JWT Secret for Session Authentication (minimum 32 characters for HS256)
JWT_SECRET="your-super-secret-jwt-signing-key-change-this-in-production-min-32-chars"

# Node Environment ('development' | 'production')
NODE_ENV="production"

# Application Base URL (e.g. https://item-scanner.vercel.app or https://items.yourcompany.com)
APP_URL="https://item-scanner.yourdomain.com"

# Google OAuth 2.0 Credentials (for Item Master Google Drive synchronization)

# GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="https://item-scanner.yourdomain.com/api/google-drive/callback"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-drive/callback"

# AES-256 Token Encryption Key at Rest (64-character hex string representing 32 bytes)
# Generate using: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Vercel Blob Read/Write Token (Required for production persistent storage on Vercel)
# Automatically injected when Vercel Blob store is linked in the Vercel Dashboard.
# In local development and tests without this token, the backend uses local file storage (.data/).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
